	column 'Churn Label' = IF('ChurnBI'[churn_flag] = 1, "Churned", "Not Churned")
		dataType: string
		lineageTag: 72dd014a-a545-4fed-9832-fa2a996d5087
		summarizeBy: none

	column Segment =
			SWITCH(
			    'ChurnBI'[segment_label],
			    "高風險客", "High Risk",
			    "超穩定低風險客", "Stable Low Risk",
			    "高價值客", "High Value",
			    "一般客", "Regular",
			    'ChurnBI'[segment_label]
			)
		dataType: string
		lineageTag: 5131aea0-19ce-4472-9b2d-9be3fde4357a
		summarizeBy: none

	partition ChurnBI = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(CsvPath), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    #"Renamed Columns" = Table.RenameColumns(#"Promoted Headers", {
					{"是否流失", "churn_flag"},
					{"預測流失機率", "churn_prob"},
					{"客群", "segment_label"},
					{"使用月數分組", "tenure_group"}
				    }),
				    #"Changed Type" = Table.TransformColumnTypes(#"Renamed Columns",{
					{"id", Int64.Type},
					{"gender", type text},
					{"SeniorCitizen", Int64.Type},
					{"Partner", type text},
					{"Dependents", type text},
					{"tenure", Int64.Type},
					{"tenure_group", type text},
					{"PhoneService", type text},
					{"MultipleLines", type text},
					{"InternetService", type text},
					{"OnlineSecurity", type text},
					{"OnlineBackup", type text},
					{"DeviceProtection", type text},
					{"TechSupport", type text},
					{"StreamingTV", type text},
					{"StreamingMovies", type text},
					{"Contract", type text},
					{"PaperlessBilling", type text},
					{"PaymentMethod", type text},
					{"MonthlyCharges", type number},
					{"TotalCharges", type number},
					{"churn_flag", Int64.Type},
					{"churn_prob", type number},
					{"segment_label", type text}
				    })
				in
				    #"Changed Type"
